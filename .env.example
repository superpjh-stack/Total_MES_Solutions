# MES 표준플랫폼 — 환경변수 (접두 MES_). 값은 저장소에 적지 않는다. 로컬은 `.env`(gitignore) 에 둔다 (G-C19).
# `make setup` 이 `.env` 가 없으면 비밀 두 개를 난수로 채워 만든다 (src/mescore/tools/init_env.py).

# 팩 선택 — 비우면 코어 단독. kimchi | foodservice | printfilm | <새 팩>. `MES_PACK=kimchi make …` 처럼 명령 앞에 붙여도 된다
MES_PACK=
# 접속 문자열 — 비우면 MES_PACK 에 따라 postgresql:///mes_core_db (코어 단독) · postgresql:///mes_<팩>_db (팩). unix socket /tmp
MES_PG_DSN=
# 실행 환경 — prod(기본 · 비워도 prod) | dev. dev 는 설명 패널 · 개발용 역할 로그인(POST /login/as — 루프백 요청만) · 500 사유 노출을 켠다. 운영에 dev 를 두지 않는다
MES_ENV=prod
MES_PORT=8030
# 세션 서명 비밀 — 비워 두면 기동할 때마다 난수(재기동 시 로그인 풀림)
MES_SESSION_SECRET=
# 공통 시드 계정(admin · prod · qa · field)의 비밀번호. 없으면 시드 · check-routes · pytest 가 명시적으로 실패한다 (G-C19)
MES_SEED_PASSWORD=
# 수집 수신(POST /ifc/collect) 토큰 — 헤더 X-Collect-Token. 비우면 수신 엔드포인트가 401 로 전부 거부한다
MES_COLLECT_TOKEN=
# 이관 배치가 읽는 서버 폴더 (F-SYS-15 · migration-files.md). 비우면 SYS-06 이 `미확정` 으로 표시한다
MES_MIGRATE_DIR=
# 로그인 실패 n회 뒤 계정 잠금 — 정본에 수치 없음 → 비우면 잠그지 않는다 (D-14)
MES_LOGIN_LOCK_COUNT=
# 현황판 자동 새로고침(초) — 기본 5 (spec.md §11 폴링 5초)
MES_BOARD_REFRESH_SECONDS=

# 코어 밖 선택 모듈 (쉼표 · 메뉴 순서). agent = MES AI Agent (D-47) · hub = 데이터 허브 (D-53)
MES_ADDONS=
# MES AI Agent 모델 (기본 claude-opus-5-5) · 키는 ANTHROPIC_API_KEY (값은 .env 에만)
MES_AGENT_MODEL=
# AI Agent 호출어(쉼표) — 비우면 로뎀 + 음성 인식 변형 (D-48)
MES_AGENT_WAKE=
# 데이터 허브 파일 보관 폴더 (비우면 저장소/var/hub) · 파일 하나 상한 MB (기본 20)
MES_HUB_DIR=
MES_HUB_MAX_MB=
